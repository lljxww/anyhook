{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Anyhook (Start Engine)",
            "cargo": {
                "args": [
                    "build",
                    "--package=anyhook-cli"
                ],
                "filter": {
                    "name": "anyhook",
                    "kind": "bin"
                }
            },
            "args": [
                "start",
                "-c",
                "anyhook.yaml"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Anyhook (List Configs)",
            "cargo": {
                "args": [
                    "build",
                    "--package=anyhook-cli"
                ],
                "filter": {
                    "name": "anyhook",
                    "kind": "bin"
                }
            },
            "args": [
                "list",
                "-c",
                "anyhook.yaml"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Hello WASM (Plugin)",
            "cargo": {
                "args": [
                    "build",
                    "--package=hello_wasm",
                    "--target=wasm32-wasip1"
                ],
                "filter": {
                    "name": "hello_wasm",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}/examples/hello_wasm",
            "env": {
                "ANYHOOK_CONTEXT": "{\"event\": {\"source\": \"test_debugger\"}}",
                "ANYHOOK_OUTPUT_FILE": "${workspaceFolder}/examples/hello_wasm/out.json"
            },
            "sourceLanguages": ["rust"]
        }
    ]
}
